{
  "name": "@breck/wws",
  "version": "0.26.0",
  "description": "The World Wide Scroll",
  "main": "wws.js",
  "engines": {
    "node": ">=18.0"
  },
  "scripts": {
    "hosts": "echo '127.0.0.1 scroll' | sudo tee -a /etc/hosts",
    "test": "node wws.test.js",
    "build": "scroll build",
    "format": "scroll format",
    "open": "open index.html",
    "up": "npm install github:breck7/scroll github:breck7/scrollsdk"
  },
  "bin": {
    "wws": "./wws.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/breck7/wws.git"
  },
  "author": "Breck Yunits",
  "prettier": {
    "parser": "babel",
    "useTabs": false,
    "tabWidth": 2,
    "semi": false,
    "printWidth": 240,
    "trailingComma": "none",
    "arrowParens": "avoid",
    "quoteProps": "as-needed"
  },
  "homepage": "https://wws.scroll.surf",
  "dependencies": {
    "express": "^5.2.1",
    "minimist": "^1.2.8",
    "scroll": "github:breck7/scroll#v180.0.1",
    "scrollsdk": "github:breck7/scrollsdk#v108.0.0"
  },
  "devDependencies": {
    "tap": "^18.7.2"
  }
}
